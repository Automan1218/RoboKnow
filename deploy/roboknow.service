[Unit]
Description=RoboKnow backend (Spring Boot)
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/roboknow
ExecStart=/usr/bin/java -jar /home/ubuntu/roboknow/app.jar --spring.profiles.active=docker
Restart=on-failure
RestartSec=10
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
