# Copy this file to /home/ubuntu/paismart/backend.env on the EC2 host.
# Replace every example value before starting the backend service.

MYSQL_ROOT_PASSWORD=replace-me
# The Docker Compose deployment exposes MySQL only on the EC2 loopback address.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
REDIS_PASSWORD=replace-me
ELASTICSEARCH_PASSWORD=replace-me
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=replace-me
OPENAI_API_KEY=replace-me
JWT_SECRET=replace-me
ADMIN_PASSWORD=replace-me
