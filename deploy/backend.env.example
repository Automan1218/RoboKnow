# Copy this file to /home/ubuntu/roboknow/backend.env on the EC2 host.
# Replace every example value before starting the backend container.

ROBO_BACKEND_IMAGE=ghcr.io/replace-with-owner/roboknow-backend:replace-with-sha

MYSQL_ROOT_PASSWORD=replace-me
REDIS_PASSWORD=replace-me
ELASTICSEARCH_PASSWORD=replace-me
MINIO_ROOT_USER=replace-me
MINIO_ROOT_PASSWORD=replace-me
OPENAI_API_KEY=replace-me
JWT_SECRET=replace-me
ADMIN_PASSWORD=replace-me
